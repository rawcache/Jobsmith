{
  "manifest_version": 3,
  "name": "Jobsmith",
  "version": "0.4.5",
  "description": "A side panel on job postings: autofill from your Jobsmith profile, resume match, who you know, cover letters, and Write with Jobsmith on open questions. Works with the Jobsmith app on your computer.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Jobsmith", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*",
    "https://*.greenhouse.io/*", "https://*.lever.co/*", "https://*.ashbyhq.com/*", "https://*.myworkdayjobs.com/*",
    "https://*.icims.com/*", "https://*.smartrecruiters.com/*"],
  "content_scripts": [{
    "matches": ["https://*/*", "http://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "commands": {
    "fill": { "suggested_key": { "default": "Alt+J" }, "description": "Fill this application" }
  }
}
